local GREEN_KEYWORDS = {
	"viridian", "emerald", "overgrowth", "woodland", "jungle", 
	"slime", "noctiflora", "toxic", "acid", "safari", "boreal", "green"
}

local function findBestGreenSkin(itemName, category)
	local skins = (database[category] and database[category][itemName]) or {}
	if #skins == 0 then return nil end

	if curatedGreenMap[itemName] then
		for _, s in ipairs(skins) do
			if s:lower() == curatedGreenMap[itemName]:lower() or s:find(curatedGreenMap[itemName]) then
				return s
			end
		end
	end

	for _, kw in ipairs(GREEN_KEYWORDS) do
		for _, s in ipairs(skins) do
			if s:lower():find(kw) then
				return s
			end
		end
	end

	return skins[1]
end

local function setupDefaultGreenSet()
	for wName, _ in pairs(database["Weapons"]) do
		local bestGreen = findBestGreenSkin(wName, "Weapons")
		if bestGreen then
			selectedWeaponSkins[wName] = bestGreen
		end
	end

	local targetKnife = "Butterfly Knife"
	if not database["Knives"][targetKnife] then
		for kName, _ in pairs(database["Knives"]) do
			if kName:lower():find("butterfly") or kName:lower():find("balisong") then
				targetKnife = kName
				break
			end
		end
	end
	if not database["Knives"][targetKnife] then
		targetKnife = next(database["Knives"]) or "Butterfly Knife"
	end

	currentKnife.model = targetKnife
	currentKnife.skin = findBestGreenSkin(targetKnife, "Knives") or "Viridian_PATTERN_1"

	currentGloves.model = "No Glove"
	currentGloves.skin = "Default"
end

pcall(function()
	ensureConfigFolder()
	local defaultPath = CONFIG_FOLDER .. "/Default.cfg"
	if isfile and isfile(defaultPath) then
		loadConfig("Default")
	else
		setupDefaultGreenSet()
		saveConfig("Default")
	end
end)

