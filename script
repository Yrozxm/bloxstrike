local blacklist = {
	["T Knife"] = true, ["CT Knife"] = true, ["Knife"] = true,
	["T Glove"] = true, ["CT Glove"] = true, ["T Gloves"] = true, ["CT Gloves"] = true,
	["C4"] = true, ["HE Grenade"] = true, ["Flashbang"] = true,
