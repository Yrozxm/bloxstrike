-- Bhop Logic
local bhopEnabled = false
local spaceHeld = false

local function setupBhop()
	UserInputService.InputBegan:Connect(function(input, gpe)
		if gpe then return end
		if input.KeyCode == Enum.KeyCode.Space then
			spaceHeld = true
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.Space then
			spaceHeld = false
		end
	end)

	if CharacterClass and Buttons then
		if not _G.__originalSampleInput then
			_G.__originalSampleInput = CharacterClass.SampleInput
		end

		local original = _G.__originalSampleInput

		CharacterClass.SampleInput = function(self, p2)
			local sample = original(self, p2)
			if not sample then return sample end

			if bhopEnabled and (spaceHeld or UserInputService:IsKeyDown(Enum.KeyCode.Space)) then
				local mv = self.MovementState
				if mv and mv.OnGround then
					sample.Buttons = Buttons.with(sample.Buttons, Buttons.Jump, true)
				else
					sample.Buttons = Buttons.with(sample.Buttons, Buttons.Jump, false)
				end
			end

			return sample
		end
	end
end

pcall(setupBhop)

-- ESP Logic
local Toggles = {
	SkeletonESP = false,
	BoxESP = false,
	Chams = false
}

local COLOR_ESP = Color3.fromRGB(255, 60, 60)
local COLOR_CHAMS = Color3.fromRGB(255, 140, 0)
local COLOR_WHITE = Color3.fromRGB(255, 255, 255)

local ESPObjects = {}
local ChamsObjects = {}

local function removeESP(player)
	if ESPObjects[player] then
		if ESPObjects[player].Lines then
			for _, line in ipairs(ESPObjects[player].Lines) do
				line.Visible = false
				pcall(function() line:Remove() end)
			end
		end
		if ESPObjects[player].Box then
			for _, quadLine in pairs(ESPObjects[player].Box) do
				quadLine.Visible = false
				pcall(function() quadLine:Remove() end)
			end
		end
		ESPObjects[player] = nil
	end
	if ChamsObjects[player] then
		pcall(function() ChamsObjects[player]:Destroy() end)
		ChamsObjects[player] = nil
	end
end

local function clearAllESP()
	for _, data in pairs(ESPObjects) do
		if data.Lines then
			for _, line in ipairs(data.Lines) do line.Visible = false end
		end
		if data.Box then
			for _, side in pairs(data.Box) do side.Visible = false end
		end
	end
	for _, highlight in pairs(ChamsObjects) do
		pcall(function() highlight.Enabled = false end)
	end
end

local function worldToScreen(worldPos)
	local screenPos, onScreen = Camera:WorldToViewportPoint(worldPos)
	return Vector2.new(screenPos.X, screenPos.Y), onScreen
end

local function getCharacterModel(player)
	local charsFolder = Workspace:FindFirstChild("Characters")
	if charsFolder then
		local found = charsFolder:FindFirstChild(player.Name) or charsFolder:FindFirstChild(tostring(player.UserId))
		if found then return found end
	end
	return player.Character
end

local function isLocalPlayerAlive()
	local char = getCharacterModel(LocalPlayer)
	if not char then return false end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum and hum.Health > 0 then return true end
	return char:FindFirstChild("HumanoidRootPart") ~= nil or char:FindFirstChild("Head") ~= nil
end

local R15_JOINTS = {
	{"Head", "UpperTorso"}, {"UpperTorso", "LowerTorso"},
	{"UpperTorso", "LeftUpperArm"}, {"LeftUpperArm", "LeftLowerArm"}, {"LeftLowerArm", "LeftHand"},
	{"UpperTorso", "RightUpperArm"}, {"RightUpperArm", "RightLowerArm"}, {"RightLowerArm", "RightHand"},
	{"LowerTorso", "LeftUpperLeg"}, {"LeftUpperLeg", "LeftLowerLeg"}, {"LeftLowerLeg", "LeftFoot"},
	{"LowerTorso", "RightUpperLeg"}, {"RightUpperLeg", "RightLowerLeg"}, {"RightLowerLeg", "RightFoot"}
}

local R6_JOINTS = {
	{"Head", "Torso"}, {"Torso", "Left Arm"}, {"Torso", "Right Arm"},
	{"Torso", "Left Leg"}, {"Torso", "Right Leg"}
}

local function getHumanoidJoints(character)
	local joints = {}
	local isR15 = character:FindFirstChild("UpperTorso") ~= nil
	local jointList = isR15 and R15_JOINTS or R6_JOINTS
	for i = 1, #jointList do
		local pair = jointList[i]
		local partA = character:FindFirstChild(pair[1])
		local partB = character:FindFirstChild(pair[2])
		if partA and partB and partA:IsA("BasePart") and partB:IsA("BasePart") then
			table.insert(joints, {partA, partB})
		end
	end
	return joints
end

local function updateChams(player, char)
	if not Toggles.Chams or player == LocalPlayer then
		if ChamsObjects[player] then ChamsObjects[player].Enabled = false end
		return
	end
	if not ChamsObjects[player] or ChamsObjects[player].Parent ~= char then
		if ChamsObjects[player] then pcall(function() ChamsObjects[player]:Destroy() end) end
		local highlight = Instance.new("Highlight")
		highlight.Name = "ESP_Chams"
		highlight.FillColor = COLOR_CHAMS
		highlight.FillTransparency = 0.5
		highlight.OutlineColor = COLOR_WHITE
		highlight.OutlineTransparency = 0.2
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.Parent = char
		ChamsObjects[player] = highlight
	end
	ChamsObjects[player].Enabled = true
end

task.spawn(function()
	while true do
		task.wait(5)
		for player, highlight in pairs(ChamsObjects) do
			if highlight then pcall(function() highlight:Destroy() end) end
		end
		table.clear(ChamsObjects)
	end
end)

local function updateESP()
	if not isLocalPlayerAlive() then
		clearAllESP()
		return
	end

	local drawingSupported = (type(Drawing) == "table" and type(Drawing.new) == "function")

	for player, data in pairs(ESPObjects) do
		local char = getCharacterModel(player)
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local isAlive = char and ((hum and hum.Health > 0) or char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head"))

		if isAlive and player ~= LocalPlayer then
			updateChams(player, char)

			if Toggles.SkeletonESP and drawingSupported then
				local joints = getHumanoidJoints(char)
				while #data.Lines < #joints do
					local ok, line = pcall(Drawing.new, "Line")
					if ok and line then
						line.Visible = false
						line.Thickness = 1.5
						line.Transparency = 1
						table.insert(data.Lines, line)
					else
						break
					end
				end
				for i = 1, #joints do
					local joint = joints[i]
					local line = data.Lines[i]
					if line then
						local posA, visA = worldToScreen(joint[1].Position)
						local posB, visB = worldToScreen(joint[2].Position)
						if visA and visB then
							line.From = posA
							line.To = posB
							line.Color = COLOR_ESP
							line.Visible = true
						else
							line.Visible = false
						end
					end
				end
				for i = #joints + 1, #data.Lines do
					if data.Lines[i] then data.Lines[i].Visible = false end
				end
			else
				for i = 1, #data.Lines do
					if data.Lines[i] then data.Lines[i].Visible = false end
				end
			end

			if Toggles.BoxESP and drawingSupported and data.Box and data.Box.Top then
				local cframe, size = char:GetBoundingBox()
				local rootPos, vis = worldToScreen(cframe.Position)
				if vis then
					local topWorld = cframe.Position + Vector3.new(0, size.Y / 2, 0)
					local bottomWorld = cframe.Position - Vector3.new(0, size.Y / 2, 0)
					local topScreen, visTop = worldToScreen(topWorld)
					local bottomScreen, visBottom = worldToScreen(bottomWorld)
					if visTop and visBottom then
						local height = math.abs(topScreen.Y - bottomScreen.Y)
						local width = height * 0.65
						local x = rootPos.X - (width / 2)
						local y = topScreen.Y

						data.Box.Top.From = Vector2.new(x, y)
						data.Box.Top.To = Vector2.new(x + width, y)
						data.Box.Top.Color = COLOR_ESP
						data.Box.Top.Visible = true

						data.Box.Bottom.From = Vector2.new(x, y + height)
						data.Box.Bottom.To = Vector2.new(x + width, y + height)
						data.Box.Bottom.Color = COLOR_ESP
						data.Box.Bottom.Visible = true

						data.Box.Left.From = Vector2.new(x, y)
						data.Box.Left.To = Vector2.new(x, y + height)
						data.Box.Left.Color = COLOR_ESP
						data.Box.Left.Visible = true

						data.Box.Right.From = Vector2.new(x + width, y)
						data.Box.Right.To = Vector2.new(x + width, y + height)
						data.Box.Right.Color = COLOR_ESP
						data.Box.Right.Visible = true
					else
						for _, side in pairs(data.Box) do side.Visible = false end
					end
				else
					for _, side in pairs(data.Box) do side.Visible = false end
				end
			else
				if data.Box then
					for _, side in pairs(data.Box) do side.Visible = false end
				end
			end
		else
			for i = 1, #data.Lines do
				if data.Lines[i] then data.Lines[i].Visible = false end
			end
			if data.Box then
				for _, side in pairs(data.Box) do side.Visible = false end
			end
			if ChamsObjects[player] then ChamsObjects[player].Enabled = false end
		end
	end
end

local function createESP(player)
	if ESPObjects[player] then removeESP(player) end
	local boxLines = nil
	if type(Drawing) == "table" and type(Drawing.new) == "function" then
		pcall(function()
			boxLines = {
				Top = Drawing.new("Line"),
				Bottom = Drawing.new("Line"),
				Left = Drawing.new("Line"),
				Right = Drawing.new("Line")
			}
			for _, line in pairs(boxLines) do
				line.Thickness = 1.5
				line.Transparency = 1
				line.Visible = false
			end
		end)
	end
	ESPObjects[player] = { Lines = {}, Box = boxLines or {}, Player = player }
end

for _, p in ipairs(Players:GetPlayers()) do createESP(p) end
Players.PlayerAdded:Connect(createESP)
Players.PlayerRemoving:Connect(removeESP)
