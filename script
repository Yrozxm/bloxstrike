-- Config System
local CONFIG_FOLDER = "SkinChanger"
local CFG_XOR_KEY = 0x57

local function ensureConfigFolder()
	if isfolder and makefolder then
		pcall(function()
			if not isfolder(CONFIG_FOLDER) then
				makefolder(CONFIG_FOLDER)
			end
		end)
	end
end
ensureConfigFolder()

local ROOTS = {"ha", "ggu", "hhr", "uxi", "oen", "hej", "eyx", "jd", "vvr", "zop", "kfa", "plk", "mno", "trw", "bex", "qut", "xyn", "wqa", "lup", "ryn"}
local PUNCT = {"-", "_", "%", ">", "<", "=", "}", "{", "]", "[", "(", ")", "!", "$", "\"", "~", "^", "&"}
local NUM_NOISE = {"388", "4!]", "9\"=", "<=", "02", "77", "91", "104", "88", "12", "501"}

local function makeNoiseWord()
	return ROOTS[math.random(1, #ROOTS)] .. PUNCT[math.random(1, #PUNCT)] .. ROOTS[math.random(1, #ROOTS)]
end

local function generateChaoticLine(byteVal)
	local token = "»" .. string.format("%02x", byteVal) .. "-%>}}"
	local c1 = ROOTS[math.random(1, #ROOTS)] .. "_-" .. ROOTS[math.random(1, #ROOTS)]
	local c2 = ROOTS[math.random(1, #ROOTS)] .. "eny}"
	local c3 = "(«" .. NUM_NOISE[math.random(1, #NUM_NOISE)]
	local c4 = "$" .. tostring(math.random(1, 9)) .. "\"=" .. NUM_NOISE[math.random(1, #NUM_NOISE)] .. ROOTS[math.random(1, #ROOTS)] .. "8" .. ROOTS[math.random(1, #ROOTS)]
	local c5 = "{" .. makeNoiseWord() .. "}"
	local c6 = "[" .. PUNCT[math.random(1, #PUNCT)] .. tostring(math.random(10, 99)) .. "]"

	local pieces = {c1, c2, c3, c4, c5}
	if math.random(1, 2) == 1 then table.insert(pieces, c6) end
	table.insert(pieces, math.random(1, #pieces + 1), token)

	return table.concat(pieces, " ")
end

local function saveConfig(name)
	if not writefile then return false end
	ensureConfigFolder()
	name = name:gsub("[^%w_%-%s]", ""):match("^%s*(.-)%s*$") or ""
	if name == "" then return false end

	local payload = {
		Weapons = selectedWeaponSkins,
		Knife = currentKnife,
		Gloves = currentGloves,
		Bhop = bhopEnabled,
		ESP = Toggles,
		_rnd = math.random(100000, 999999)
	}

	local rawJson = HttpService:JSONEncode(payload)
	if #rawJson < 268 then
		payload._noise = string.rep("q", 268 - #rawJson)
		rawJson = HttpService:JSONEncode(payload)
	end

	local lines = {}
	for i = 1, #rawJson do
		local b = string.byte(rawJson, i)
		local rotKey = bit32.band(CFG_XOR_KEY + (i * 23) + (i % 13), 0xFF)
		local enc = bit32.bxor(b, rotKey)
		table.insert(lines, generateChaoticLine(enc))
	end

	return pcall(writefile, CONFIG_FOLDER .. "/" .. name .. ".cfg", table.concat(lines, "\n"))
end

local function loadConfig(name)
	if not readfile then return false end
	ensureConfigFolder()
	local filePath = CONFIG_FOLDER .. "/" .. name .. ".cfg"
	if isfile and not isfile(filePath) then return false end

	local ok, content = pcall(readfile, filePath)
	if not ok or not content then return false end

	local encBytes = {}
	for hex in string.gmatch(content, "»(%x%x)") do
		local b = tonumber(hex, 16)
		if b then table.insert(encBytes, b) end
	end

	if #encBytes == 0 then return false end

	local chars = {}
	for i = 1, #encBytes do
		local enc = encBytes[i]
		local rotKey = bit32.band(CFG_XOR_KEY + (i * 23) + (i % 13), 0xFF)
		table.insert(chars, string.char(bit32.bxor(enc, rotKey)))
	end

	local decOk, data = pcall(HttpService.JSONDecode, HttpService, table.concat(chars, ""))
	if not decOk or type(data) ~= "table" then return false end

	if type(data.Weapons) == "table" then selectedWeaponSkins = data.Weapons end
	if type(data.Knife) == "table" and data.Knife.model and data.Knife.skin then
		updateLiveKnife(data.Knife.model, data.Knife.skin)
	end
	if type(data.Gloves) == "table" and data.Gloves.model then
		queueGloves(data.Gloves.model, data.Gloves.skin or "")
	end
	if type(data.Bhop) == "boolean" then
		bhopEnabled = data.Bhop
	end
	if type(data.ESP) == "table" then
		for k, v in pairs(data.ESP) do
			if Toggles[k] ~= nil and type(v) == "boolean" then
				Toggles[k] = v
			end
		end
		if not Toggles.SkeletonESP and not Toggles.BoxESP and not Toggles.Chams then
			clearAllESP()
		end
	end

	return true
end

local function deleteConfig(name)
	if not delfile then return false end
	ensureConfigFolder()
	return pcall(delfile, CONFIG_FOLDER .. "/" .. name .. ".cfg")
end

local function getSavedConfigs()
	ensureConfigFolder()
	local list = {}
	if listfiles then
		local success, files = pcall(listfiles, CONFIG_FOLDER)
		if success and type(files) == "table" then
			for _, path in ipairs(files) do
				local clean = path:gsub("\\", "/")
				local cfgName = clean:match("([^/]+)%.cfg$")
				if cfgName then table.insert(list, cfgName) end
			end
		end
	end
	table.sort(list)
	return list
end

