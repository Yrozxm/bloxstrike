local function isKnife(name)
	if type(name) ~= "string" then return false end
	local lower = name:lower()
	return lower:find("knife") ~= nil 
		or lower:find("karambit") ~= nil 
		or lower:find("melee") ~= nil 
		or lower:find("butterfly") ~= nil
		or lower:find("balisong") ~= nil
		or lower:find("bayonet") ~= nil
		or lower:find("lightsaber") ~= nil
		or lower:find("stiletto") ~= nil
end

local function isValidSkin(weaponName, skinName)
	if not skinsFolder or not weaponName or not skinName then return false end
	local wFolder = skinsFolder:FindFirstChild(weaponName)
	if not wFolder then return false end
	return wFolder:FindFirstChild(skinName) ~= nil
end

local function applySkinToViewModel(viewmodel, weaponName, skinName, wear)
	if not skinsFolder or not viewmodel or not weaponName then return false end
	local weaponFolder = skinsFolder:FindFirstChild(weaponName)
	if not weaponFolder then return false end

	local targetSkin = skinName or "Stock"
	local skin = weaponFolder:FindFirstChild(targetSkin)
	if not skin and targetSkin == "Stock" then
		skin = weaponFolder:FindFirstChild("Vanilla") or weaponFolder:GetChildren()[1]
	end
	if not skin then return false end

	local camFolder = skin:FindFirstChild("Camera") or skin
	local wearFolder = camFolder:FindFirstChild(wear or "Factory New") 
		or camFolder:FindFirstChild("Factory New")
		or camFolder:FindFirstChild("Minimal Wear")
		or camFolder:FindFirstChild("Field-Tested")
		or camFolder:GetChildren()[1]

	if not wearFolder then return false end

	pcall(function()
		for _, sa in ipairs(wearFolder:GetChildren()) do
			if sa:IsA("SurfaceAppearance") then
				local targetPart = viewmodel:FindFirstChild(sa.Name, true)
				if targetPart and (targetPart:IsA("MeshPart") or targetPart:IsA("BasePart")) then
					local old = targetPart:FindFirstChildOfClass("SurfaceAppearance")
					if old then old:Destroy() end
					local clone = sa:Clone()
					clone.Parent = targetPart
				end
			end
		end
	end)
	return true
end

local function getActiveLoadout()
	if not InventoryController then
		pcall(function()
			InventoryController = require(ReplicatedStorage.Controllers.InventoryController)
		end)
	end
	if not InventoryController then return nil end

	if type(getupvalues) == "function" then
		for _, fnName in ipairs({"getCurrentEquipped", "removeInventoryItem", "getInventorySlot", "getCurrentInventory"}) do
			local fn = InventoryController[fnName]
			if type(fn) == "function" then
				local ok, uvs = pcall(getupvalues, fn)
				if ok and type(uvs) == "table" then
					for _, uv in pairs(uvs) do
						if type(uv) == "table" and rawget(uv, "Inventory") then
							return uv
						end
					end
				end
			end
		end
	end
	return nil
end

local function updateLiveKnife(targetKnife, knifeSkin)
	currentKnife.model = targetKnife
	currentKnife.skin = knifeSkin

	local ld = getActiveLoadout()
	if not ld or not ld.Inventory then return false end

	local knifeSlot = ld.Inventory[3] or ld.Inventory["3"] or ld.Inventory["Melee"]
	if not knifeSlot then return false end

	local itemsList = knifeSlot._items or knifeSlot.items or knifeSlot
	local knifeItem = itemsList[1]
	if not knifeItem then return false end

	local wasEquipped = (ld.CurrentEquipped == knifeItem) or (knifeItem.Viewmodel and knifeItem.Viewmodel.IsEquipped == true)

	knifeItem.Name = targetKnife
	knifeItem.Skin = knifeSkin

	if GetWeaponProperties then
		pcall(function()
			knifeItem.Properties = GetWeaponProperties(targetKnife) or knifeItem.Properties
		end)
	end

	pcall(function()
		if CharacterAnimator then
			if knifeItem.CharacterAnimator and knifeItem.CharacterAnimator.destroy then
				knifeItem.CharacterAnimator:destroy()
			end
			knifeItem.CharacterAnimator = CharacterAnimator.new(LocalPlayer, targetKnife)
		end
	end)

	if knifeItem.Viewmodel then
		local vm = knifeItem.Viewmodel
		vm.Weapon = targetKnife
		vm.CameraModelWeapon = targetKnife
		vm.Skin = knifeSkin

		pcall(function()
			if Sound and Sound.new then
				if vm.Sound and vm.Sound.destroy then vm.Sound:destroy() end
				vm.Sound = Sound.new(targetKnife)
				if vm.Animation then
					vm.Animation.Sound = vm.Sound
				end
			end
		end)

		pcall(function()
			if vm.CameraModel then
				for _, ch in ipairs(vm.CameraModel:GetChildren()) do
					if ch.Name == "Weapon" or ch:IsA("Model") or isKnife(ch.Name) then
						ch:Destroy()
					end
				end
			end
			for _, ch in ipairs(Camera:GetChildren()) do
				if ch:IsA("Model") and isKnife(ch.Name) then
					ch:Destroy()
				end
			end
		end)

		local char = LocalPlayer.Character
		if char and vm.construct then
			pcall(function()
				vm:construct(char, knifeItem)
			end)
		end

		if wasEquipped and vm.equip then
			pcall(function()
				vm:equip(false)
			end)
		end
	end

	pcall(function()
		local ic = InventoryController or require(ReplicatedStorage.Controllers.InventoryController)
		if ic then
			if ic.OnInventoryChanged then
				ic.OnInventoryChanged:Fire(ld.Inventory)
			end
			if wasEquipped and ic.OnInventoryItemEquipped then
				ic.OnInventoryItemEquipped:Fire(3, knifeItem)
			end
		end
	end)

	task.defer(function()
		task.wait(0.04)
		for _, child in ipairs(Camera:GetChildren()) do
			if child:IsA("Model") and (child:FindFirstChild("Weapon") or child:FindFirstChild("WeaponL") or child:FindFirstChild("WeaponR") or isKnife(child.Name)) then
				if isKnife(child.Name) or child.Name == targetKnife or child.Name == "Knife" then
					child.Name = targetKnife
					applySkinToViewModel(child, targetKnife, knifeSkin, "Factory New")
				end
			end
		end
	end)

	return true
end

if WeaponComponent and WeaponComponent.new then
	local origWeaponNew = WeaponComponent.new
	WeaponComponent.new = function(p1, p2, p3, p4, p5, p6, p7, p8, p9, p10, p11, p12, ...)
		if p1 == LocalPlayer and type(p5) == "string" then
			if isKnife(p5) then
				if currentKnife.model and currentKnife.skin and isValidSkin(currentKnife.model, currentKnife.skin) then
					return origWeaponNew(p1, p2, p3, p4, currentKnife.model, currentKnife.skin, 0.001, p8, p9, p10, p11, p12, ...)
				end
			elseif selectedWeaponSkins[p5] and isValidSkin(p5, selectedWeaponSkins[p5]) then
				return origWeaponNew(p1, p2, p3, p4, p5, selectedWeaponSkins[p5], 0.001, p8, p9, p10, p11, p12, ...)
			end
		end
		return origWeaponNew(p1, p2, p3, p4, p5, p6, p7, p8, p9, p10, p11, p12, ...)
	end
end

if SkinsLib and SkinsLib.GetCameraModel then
	local origGetCameraModel = SkinsLib.GetCameraModel
	SkinsLib.GetCameraModel = function(weaponName, skinName, float, statTrack, nameTag, charm, stickers, team)
		if type(weaponName) == "string" then
			if isKnife(weaponName) then
				if currentKnife.model and currentKnife.skin then
					local model = origGetCameraModel(currentKnife.model, currentKnife.skin, 0.001, statTrack, nameTag, charm, stickers, team)
					if model then
						model.Name = currentKnife.model
					end
					return model
				end
			elseif selectedWeaponSkins[weaponName] then
				return origGetCameraModel(weaponName, selectedWeaponSkins[weaponName], 0.001, statTrack, nameTag, charm, stickers, team)
			end
		end
		return origGetCameraModel(weaponName, skinName, float, statTrack, nameTag, charm, stickers, team)
	end
end

local function hideGloveOverlays(vmModel)
	if not vmModel then return end
	pcall(function()
		for _, desc in ipairs(vmModel:GetDescendants()) do
			if desc:IsA("SurfaceAppearance") and desc.Name:lower():find("glove") then
				desc:Destroy()
			end
			if (desc:IsA("MeshPart") or desc:IsA("BasePart")) then
				local dName = desc.Name:lower()
				local pName = desc.Parent and desc.Parent.Name:lower() or ""
				if (dName:find("glove") or pName:find("glove")) and not dName:find("arm") then
					desc.Transparency = 1
					local sa = desc:FindFirstChildOfClass("SurfaceAppearance")
					if sa then sa:Destroy() end
				end
			end
		end
	end)
end

local function applyGloveAppearanceOnly(vmModel, sourceFolder)
	if not vmModel or not sourceFolder then return end

	local leftSA, rightSA, generalSA = nil, nil, nil
	for _, sa in ipairs(sourceFolder:GetDescendants()) do
		if sa:IsA("SurfaceAppearance") then
			local sName = sa.Name:lower()
			if sName:find("left") or sName:find("_l") then
				leftSA = sa
			elseif sName:find("right") or sName:find("_r") then
				rightSA = sa
			else
				generalSA = sa
			end
		end
	end

	pcall(function()
		for _, desc in ipairs(vmModel:GetDescendants()) do
			if desc:IsA("MeshPart") or desc:IsA("BasePart") then
				local dName = desc.Name:lower()
				local pName = desc.Parent and desc.Parent.Name:lower() or ""

				local isGlovePart = (dName:find("glove") ~= nil or pName:find("glove") ~= nil)
				local isArmOrBody = (dName:find("arm") or dName:find("sleeve") or dName:find("body") or dName:find("character"))

				if isGlovePart and not isArmOrBody then
					desc.Transparency = 0
					local targetSA = nil
					if dName:find("left") or dName:find("_l") then
						targetSA = leftSA or generalSA
					elseif dName:find("right") or dName:find("_r") then
						targetSA = rightSA or generalSA
					else
						targetSA = generalSA or leftSA or rightSA
					end

					if targetSA then
						local old = desc:FindFirstChildOfClass("SurfaceAppearance")
						if old then old:Destroy() end
						local clone = targetSA:Clone()
						clone.Parent = desc
					end
				end
			end
		end
	end)
end

local function replaceGlovePart(targetContainer, sourceFN)
	if not targetContainer or not sourceFN then return end
	local oldFN = targetContainer:FindFirstChild("Factory New")
	if oldFN then oldFN:Destroy() end
	local cloneFN = sourceFN:Clone()
	cloneFN.Name = "Factory New"
	cloneFN.Parent = targetContainer
end

local function queueGloves(gloveName, skinName)
	if gloveName == "No Glove" or gloveName == "" then
		currentGloves.model = "No Glove"
		currentGloves.skin = "Default"

		if ctCamera and ctCamera:FindFirstChild("Factory New") then ctCamera["Factory New"]:Destroy() end
		if ctCharacter and ctCharacter:FindFirstChild("Factory New") then ctCharacter["Factory New"]:Destroy() end
		if tCamera and tCamera:FindFirstChild("Factory New") then tCamera["Factory New"]:Destroy() end
		if tCharacter and tCharacter:FindFirstChild("Factory New") then tCharacter["Factory New"]:Destroy() end

		for _, vmModel in ipairs(Camera:GetChildren()) do
			if vmModel:IsA("Model") then
				hideGloveOverlays(vmModel)
			end
		end
		return
	end

	if not skinsFolder then return end
	local gloveFolder = skinsFolder:FindFirstChild(gloveName)
	if not gloveFolder then return end
	local skinFolder = gloveFolder:FindFirstChild(skinName)
	if not skinFolder then return end

	local cam = skinFolder:FindFirstChild("Camera")
	local char = skinFolder:FindFirstChild("Character")
	local camFN = cam and (cam:FindFirstChild("Factory New") or cam:GetChildren()[1])
	local charFN = char and (char:FindFirstChild("Factory New") or char:GetChildren()[1])

	if camFN and charFN then
		currentGloves.model = gloveName
		currentGloves.skin = skinName

		if ctCamera then replaceGlovePart(ctCamera, camFN) end
		if ctCharacter then replaceGlovePart(ctCharacter, charFN) end
		if tCamera then replaceGlovePart(tCamera, camFN) end
		if tCharacter then replaceGlovePart(tCharacter, charFN) end

		for _, vmModel in ipairs(Camera:GetChildren()) do
			if vmModel:IsA("Model") then
				for _, sub in ipairs(vmModel:GetDescendants()) do
					if sub.Name == "Camera" and sub:IsA("Model") then
						replaceGlovePart(sub, camFN)
					end
				end
				applyGloveAppearanceOnly(vmModel, camFN)
			end
		end
	end
end

local function applySkinsToModel(child)
	if not child:IsA("Model") then return end

	task.spawn(function()
		local weaponPart = child:FindFirstChild("Weapon") or child:FindFirstChild("WeaponL") or child:FindFirstChild("WeaponR")
		if not weaponPart then
			weaponPart = child:WaitForChild("Weapon", 1) or child:WaitForChild("WeaponL", 0.5) or child:WaitForChild("WeaponR", 0.5)
		end
		if not weaponPart then return end

		local weaponName = child.Name
		if currentGloves.model == "No Glove" then
			hideGloveOverlays(child)
		elseif currentGloves.model ~= "" and currentGloves.skin ~= "" then
			queueGloves(currentGloves.model, currentGloves.skin)
		end

		if isKnife(weaponName) or weaponName == currentKnife.model or weaponName == "Knife" then
			if currentKnife.model and currentKnife.skin then
				child.Name = currentKnife.model
				applySkinToViewModel(child, currentKnife.model, currentKnife.skin, "Factory New")
			end
		elseif selectedWeaponSkins[weaponName] then
			applySkinToViewModel(child, weaponName, selectedWeaponSkins[weaponName], "Factory New")
		end
	end)
end

