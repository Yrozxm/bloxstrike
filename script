		backBtn.Visible = true
		navTitle.Position = UDim2.new(0, 98, 0, 0)
		navTitle.Text = currentCategory .. " > " .. selectedItem

		local skins = (database[currentCategory] and database[currentCategory][selectedItem]) or {}
		for _, skinName in ipairs(skins) do
			local btn = Instance.new("TextButton")
			btn.Name = skinName
			btn.Size = UDim2.new(1, 0, 0, 38)
			btn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
