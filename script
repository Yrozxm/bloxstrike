				btn.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
				btn.TextStrokeTransparency = 0
				btn.Text = string.format("   [*] %s (ON)", opt.Name)
			else
				btn.TextColor3 = Color3.fromRGB(230, 230, 240)
				btn.TextStrokeTransparency = 1
				btn.Text = string.format("   [ ] %s (OFF)", opt.Name)
			end

			btn.Parent = scroll

			btn.MouseButton1Click:Connect(function()
				Toggles[opt.Key] = not Toggles[opt.Key]
				if not Toggles[opt.Key] then
					clearAllESP()
				end
				notify(opt.Name .. ": " .. (Toggles[opt.Key] and "Enabled" or "Disabled"))
				renderContent()
			end)
		end

		return
	end

	if currentCategory == "Configs" then
		backBtn.Visible = false
		navTitle.Position = UDim2.new(0, 3, 0, 0)
		navTitle.Text = "Configs"

		local saveBoxFrame = Instance.new("Frame")
		saveBoxFrame.Name = "00_SaveFrame"
		saveBoxFrame.Size = UDim2.new(1, 0, 0, 38)
		saveBoxFrame.BackgroundTransparency = 1
		saveBoxFrame.BorderSizePixel = 0
		saveBoxFrame.Parent = scroll

		local nameInput = Instance.new("TextBox")
		nameInput.PlaceholderText = "Name for config..."
		nameInput.Text = ""
		nameInput.Size = UDim2.new(1, -120, 1, 0)
		nameInput.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		nameInput.BorderSizePixel = 1
		nameInput.BorderColor3 = Color3.fromRGB(255, 140, 0)
		nameInput.TextColor3 = Color3.fromRGB(255, 255, 255)
		nameInput.Font = Enum.Font.Code
		nameInput.TextSize = 13
		nameInput.Parent = saveBoxFrame

		local saveBtn = Instance.new("TextButton")
		saveBtn.Text = "Save"
		saveBtn.Size = UDim2.new(0, 112, 1, 0)
		saveBtn.Position = UDim2.new(1, -112, 0, 0)
		saveBtn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		saveBtn.BorderSizePixel = 0
		saveBtn.TextColor3 = Color3.fromRGB(0, 255, 0)
		saveBtn.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
		saveBtn.TextStrokeTransparency = 0
		saveBtn.Font = Enum.Font.Code
		saveBtn.TextSize = 13
		saveBtn.Parent = saveBoxFrame

		saveBtn.MouseButton1Click:Connect(function()
			local cfgName = nameInput.Text
			if cfgName and #cfgName > 0 then
				if saveConfig(cfgName) then
					notify("Config: " .. cfgName .. " Saved")
					nameInput.Text = ""
					renderContent()
				else
					notify("Failed")
				end
			end
		end)

		local configs = getSavedConfigs()
		if #configs == 0 then
			local emptyLabel = Instance.new("TextLabel")
			emptyLabel.Name = "01_Empty"
			emptyLabel.Size = UDim2.new(1, 0, 0, 42)
			emptyLabel.BackgroundTransparency = 1
			emptyLabel.BorderSizePixel = 0
			emptyLabel.Text = "No saved configs"
			emptyLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
			emptyLabel.Font = Enum.Font.Code
			emptyLabel.TextSize = 13
			emptyLabel.Parent = scroll
		else
			for _, cfg in ipairs(configs) do
				local card = Instance.new("Frame")
				card.Name = cfg
				card.Size = UDim2.new(1, 0, 0, 38)
				card.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
				card.BorderSizePixel = 0
				card.Parent = scroll

				local cfgLabel = Instance.new("TextLabel")
				cfgLabel.Text = " " .. cfg .. ".cfg"
				cfgLabel.Size = UDim2.new(1, -135, 1, 0)
				cfgLabel.BackgroundTransparency = 1
				cfgLabel.BorderSizePixel = 0
				cfgLabel.TextColor3 = (cfg == "Default") and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(230, 230, 240)
				if cfg == "Default" then
					cfgLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
					cfgLabel.TextStrokeTransparency = 0
				end
				cfgLabel.Font = Enum.Font.Code
				cfgLabel.TextSize = 13
				cfgLabel.TextXAlignment = Enum.TextXAlignment.Left
				cfgLabel.Parent = card

				local loadBtn = Instance.new("TextButton")
				loadBtn.Text = "Load"
				loadBtn.Size = UDim2.new(0, 91, 0, 28)
				loadBtn.Position = UDim2.new(1, -130, 0, 5)
				loadBtn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
				loadBtn.BorderSizePixel = 0
				loadBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
				loadBtn.Font = Enum.Font.Code
				loadBtn.TextSize = 12
				loadBtn.Parent = card

				loadBtn.MouseButton1Click:Connect(function()
					if loadConfig(cfg) then
						notify("Config applied!")
						renderContent()
					end
				end)

				local delBtn = Instance.new("TextButton")
				delBtn.Text = "X"
				delBtn.Size = UDim2.new(0, 28, 0, 28)
				delBtn.Position = UDim2.new(1, -33, 0, 5)
				delBtn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
				delBtn.BorderSizePixel = 0
				delBtn.TextColor3 = Color3.fromRGB(255, 80, 80)
				delBtn.Font = Enum.Font.Code
				delBtn.TextSize = 14
				delBtn.Parent = card

				delBtn.MouseButton1Click:Connect(function()
					if deleteConfig(cfg) then
						notify("Deleted: " .. cfg .. ".cfg")
						renderContent()
					end
				end)
			end
		end
		return
	end

	if not selectedItem then
		backBtn.Visible = false
		navTitle.Position = UDim2.new(0, 3, 0, 0)
		navTitle.Text = "" .. currentCategory

		local items = database[currentCategory] or {}
		for itemName, _ in pairs(items) do
			local btn = Instance.new("TextButton")
			btn.Name = itemName
			btn.Size = UDim2.new(1, 0, 0, 38)
			btn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
			btn.BorderSizePixel = 1
			btn.BorderColor3 = Color3.fromRGB(255, 140, 0)
			btn.Font = Enum.Font.Code
			btn.TextSize = 13
			btn.TextXAlignment = Enum.TextXAlignment.Left

			local activeSkin = nil
			if currentCategory == "Weapons" then
				activeSkin = selectedWeaponSkins[itemName]
			elseif currentCategory == "Knives" then
				if currentKnife.model == itemName then
					activeSkin = currentKnife.skin
				end
			elseif currentCategory == "Gloves" then
				if currentGloves.model == itemName then
					activeSkin = currentGloves.skin
				end
			end

			if activeSkin then
				btn.TextColor3 = Color3.fromRGB(0, 255, 0)
				btn.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
				btn.TextStrokeTransparency = 0
				btn.Text = string.format("   %s > %s", itemName, activeSkin)
			else
				btn.TextColor3 = Color3.fromRGB(230, 230, 240)
				btn.TextStrokeTransparency = 1
				btn.Text = "   " .. itemName
			end

			btn.Parent = scroll

			btn.MouseButton1Click:Connect(function()
				if currentCategory == "Gloves" and itemName == "No Glove" then
					queueGloves("No Glove", "Default")
					notify("Gloves: Removed (Bare Hands)")
					renderContent()
				else
					selectedItem = itemName
					renderContent()
				end
			end)
		end
	else
		backBtn.Visible = true
		navTitle.Position = UDim2.new(0, 98, 0, 0)
		navTitle.Text = currentCategory .. " > " .. selectedItem

		local skins = (database[currentCategory] and database[currentCategory][selectedItem]) or {}
		for _, skinName in ipairs(skins) do
			local btn = Instance.new("TextButton")
			btn.Name = skinName
			btn.Size = UDim2.new(1, 0, 0, 38)
			btn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
			btn.BorderSizePixel = 1
			btn.BorderColor3 = Color3.fromRGB(255, 140, 0)
			btn.Font = Enum.Font.Code
			btn.TextSize = 13
			btn.TextXAlignment = Enum.TextXAlignment.Left

			local isSelected = false
			if currentCategory == "Weapons" then
				isSelected = (selectedWeaponSkins[selectedItem] == skinName)
			elseif currentCategory == "Knives" then
				isSelected = (currentKnife.model == selectedItem and currentKnife.skin == skinName)
			elseif currentCategory == "Gloves" then
				isSelected = (currentGloves.model == selectedItem and currentGloves.skin == skinName)
			end

			if isSelected then
				btn.TextColor3 = Color3.fromRGB(0, 255, 0)
				btn.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
				btn.TextStrokeTransparency = 0
				btn.Text = string.format("   [*] %s | %s", selectedItem, skinName)
			else
				btn.TextColor3 = Color3.fromRGB(230, 230, 240)
				btn.TextStrokeTransparency = 1
				btn.Text = string.format("   %s | %s", selectedItem, skinName)
			end

			btn.Parent = scroll

			btn.MouseButton1Click:Connect(function()
				if currentCategory == "Weapons" then
					selectedWeaponSkins[selectedItem] = skinName
					notify(string.format("%s | %s", selectedItem, skinName))
				elseif currentCategory == "Knives" then
					updateLiveKnife(selectedItem, skinName)
					notify(string.format("Knife: %s | %s", selectedItem, skinName))
				elseif currentCategory == "Gloves" then
					queueGloves(selectedItem, skinName)
					notify(string.format("Gloves: %s | %s", selectedItem, skinName))
				end

				renderContent()
			end)
		end
	end
end

backBtn.MouseButton1Click:Connect(function()
	selectedItem = nil
	renderContent()
end)

local categoriesList = {"Weapons", "Knives", "Gloves", "Configs", "Bhop", "ESP"}
for _, cat in ipairs(categoriesList) do
	local tabBtn = Instance.new("TextButton")
	tabBtn.Name = cat
	tabBtn.Text = cat
	tabBtn.Size = UDim2.new(0, 71, 1, 0)
	tabBtn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	tabBtn.BorderSizePixel = 0
	tabBtn.Font = Enum.Font.Code
	tabBtn.TextSize = 13
	tabBtn.Parent = tabsBar

	tabButtons[cat] = tabBtn

	tabBtn.MouseButton1Click:Connect(function()
		currentCategory = cat
		selectedItem = nil

		for name, button in pairs(tabButtons) do
			if name == cat then
				button.TextColor3 = Color3.fromRGB(0, 255, 0)
				button.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
				button.TextStrokeTransparency = 0
			else
				button.TextColor3 = Color3.fromRGB(150, 150, 150)
				button.TextStrokeTransparency = 1
			end
		end

		renderContent()
	end)
end

tabButtons["Weapons"].TextColor3 = Color3.fromRGB(0, 255, 0)
tabButtons["Weapons"].TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
tabButtons["Weapons"].TextStrokeTransparency = 0

for _, cat in ipairs({"Knives", "Gloves", "Configs", "Bhop", "ESP"}) do
	tabButtons[cat].TextColor3 = Color3.fromRGB(150, 150, 150)
	tabButtons[cat].TextStrokeTransparency = 1
end

renderContent()
