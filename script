		StarterGui:SetCore("SendNotification", {
			Title = "Skin Changer",
			Text = text,
			Duration = 2.5
		})
	end)
end

local function clearScroll()
	for _, child in ipairs(scroll:GetChildren()) do
		if child:IsA("GuiObject") and not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
			child:Destroy()
		end
	end
end

