local blacklist = {
	["T Knife"] = true, ["CT Knife"] = true, ["Knife"] = true,
	["T Glove"] = true, ["CT Glove"] = true, ["T Gloves"] = true, ["CT Gloves"] = true,
	["C4"] = true, ["HE Grenade"] = true, ["Flashbang"] = true,
	["Smoke Grenade"] = true, ["Decoy"] = true, ["Molotov"] = true,
	["Incendiary Grenade"] = true, ["Badge"] = true, ["Booth"] = true, ["Name Tag"] = true
}

local function classify(name)
	if blacklist[name] then return nil end
	local low = name:lower()
	if low:find("glove") or low:find("wraps") then
		return "Gloves"
	elseif low:find("knife") or low:find("karambit") or low:find("balisong") or low:find("butterfly") or low:find("bayonet") or low:find("lightsaber") or low:find("stiletto") then
		return "Knives"
	end
	return "Weapons"
end

if skinsFolder then
	for _, itemFolder in ipairs(skinsFolder:GetChildren()) do
		local cat = classify(itemFolder.Name)
		if cat then
			local skins = {}
			for _, sFolder in ipairs(itemFolder:GetChildren()) do
				if sFolder:IsA("Folder") then
					local sName = sFolder.Name
					if sName:lower() ~= "stock" and not sName:find("^Stock") then
						table.insert(skins, sName)
					end
				end
			end
			table.sort(skins)
			if #skins > 0 then
				database[cat][itemFolder.Name] = skins
			end
		end
	end
end

local curatedGreenMap = {
	["AWP"] = "Koi Pond",
	["AUG"] = "Overgrowth",
	["M4A1-S"] = "Bloggd",
	["MAG-7"] = "Ambulance",
	["Negev"] = "The Jungle",
	["Nova"] = "Slime",
	["AK-47"] = "Overgrowth",
	["Desert Eagle"] = "Emerald",
	["USP-S"] = "Overgrowth",
	["Glock-18"] = "Woodland",
	["SSG 08"] = "Woodland",
	["P90"] = "Viridian",
}

local GREEN_KEYWORDS = {
	"viridian", "emerald", "overgrowth", "woodland", "jungle", 
	"slime", "noctiflora", "toxic", "acid", "safari", "boreal", "green"
}

local function findBestGreenSkin(itemName, category)
	local skins = (database[category] and database[category][itemName]) or {}
	if #skins == 0 then return nil end

	if curatedGreenMap[itemName] then
		for _, s in ipairs(skins) do
			if s:lower() == curatedGreenMap[itemName]:lower() or s:find(curatedGreenMap[itemName]) then
				return s
			end
		end
	end

	for _, kw in ipairs(GREEN_KEYWORDS) do
		for _, s in ipairs(skins) do
			if s:lower():find(kw) then
				return s
			end
		end
	end

	return skins[1]
end

local function setupDefaultGreenSet()
	for wName, _ in pairs(database["Weapons"]) do
		local bestGreen = findBestGreenSkin(wName, "Weapons")
		if bestGreen then
			selectedWeaponSkins[wName] = bestGreen
		end
	end

	local targetKnife = "Butterfly Knife"
	if not database["Knives"][targetKnife] then
		for kName, _ in pairs(database["Knives"]) do
			if kName:lower():find("butterfly") or kName:lower():find("balisong") then
				targetKnife = kName
				break
			end
		end
	end
	if not database["Knives"][targetKnife] then
		targetKnife = next(database["Knives"]) or "Butterfly Knife"
	end

	currentKnife.model = targetKnife
	currentKnife.skin = findBestGreenSkin(targetKnife, "Knives") or "Viridian_PATTERN_1"

	currentGloves.model = "No Glove"
	currentGloves.skin = "Default"
end

