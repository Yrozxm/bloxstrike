local function updateCursorPosition()
	local mPos = UserInputService:GetMouseLocation()
	customCursor.Position = UDim2.fromOffset(mPos.X, mPos.Y)
end

local function setMenuVisible(state)
	mainFrame.Visible = state
	customCursor.Visible = state
	cursorModalUnlocker.Visible = state
	cursorModalUnlocker.Modal = state

	if state then
		updateCursorPosition()
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		UserInputService.MouseIconEnabled = false
	else
		UserInputService.MouseIconEnabled = false
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
	end
end

UserInputService.InputChanged:Connect(function(input)
	if mainFrame.Visible and input.UserInputType == Enum.UserInputType.MouseMovement then
		updateCursorPosition()
	end
end)

RunService.RenderStepped:Connect(function()
	if mainFrame.Visible then
		if UserInputService.MouseBehavior ~= Enum.MouseBehavior.Default then
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		end
		if UserInputService.MouseIconEnabled then
			UserInputService.MouseIconEnabled = false
		end
	end
end)

